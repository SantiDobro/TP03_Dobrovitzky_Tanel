    <h1>MusicStore</h1>
    <p>Bienvenidos al sitio web de Dobro y Lior</p>
   <section>
    @foreach(Disco disco in ViewBag.discos)
    {
      <div>
        <img src="/img/@disco.Foto" alt="Foto" width="300" height="auto">
        <h1>@disco.Nombre</h1>
        <h3>@disco.Artista.Nombre<h3>
          <a href= '@Url.Action("SelectDisco", "Home", new { id = disco.ID})'>  <input type = "button" value = "Ver disco completo">
          </a>
      </div>
    }
   </section>

